# Supabase — ver docs/05-arquitectura-tecnica.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string directa (Settings → Database) — solo para correr migraciones vía scripts/run-migrations.mjs
DATABASE_URL=

# Proveedor de IA para Transition AI — ver docs/06-arquitectura-ia.md §6.4
# Solo una de estas es requerida según el proveedor activo en /lib/ai/provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
# Modelo para el chat. Debe existir en el catálogo habilitado para la clave.
KIMI_CHAT_MODEL=kimi-k3
# Cuota mensual por usuario Premium, sumando tokens de entrada y salida.
AI_MONTHLY_TOKEN_LIMIT=100000

# Integración con CRM de ONIX — ver docs/07-inteligencia-leads.md §7.5
# Mientras ONIX no confirme el CRM definitivo, se usa el adaptador webhook genérico
LEADS_CRM_WEBHOOK_URL=
